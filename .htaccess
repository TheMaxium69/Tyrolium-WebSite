# ══════════════════════════════════════════════════════════════════
# tyrolium.fr — Apache (pré-rendu)
# Généré par scripts/tyrobuild.mjs : ne pas modifier dans prod/,
# modifier scripts/server-config/apache.htaccess puis relancer tyrobuild.
# ══════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ==========================================
  # 1. FORCER LE HTTPS (Optimisé OVH)
  # ==========================================
  # Vérifie si le HTTPS est désactivé ou si le reverse proxy OVH n'est pas en HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ==========================================
  # 2. FICHIERS CACHÉS (.git, .gitignore…)
  # ==========================================
  # Le dossier déployé est un dépôt git : on ne sert jamais un fichier ou dossier caché
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

  # ==========================================
  # 3. PAGES SUPPRIMÉES DÉFINITIVEMENT (410 Gone)
  # ==========================================
  # Anciennes URLs encore référencées : 410 dit aux moteurs de les retirer pour de bon
  # (liste "gone" dans scripts/tyrobuild.mjs)
  RewriteRule ^(ServerMC|Panel)(/.*)?$ - [R=410,L]

  # ==========================================
  # 4. EXCLUSION DE DOSSIERS SPÉCIFIQUES
  # ==========================================
  # Dossiers laissés en comportement natif Apache (liste dans scripts/tyrobuild.mjs)
  RewriteRule ^(Download|generate-pp|Contenu/Image)($|/) - [L]

  # ==========================================
  # 5. IMAGES WEBP (négociation de contenu)
  # ==========================================
  # tyrobuild crée logo.png.webp à côté de logo.png : un navigateur qui accepte le WebP
  # reçoit la version WebP (plus légère) à la même adresse, les autres reçoivent le PNG / JPEG
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(.+\.(?:png|jpe?g))$ /$1.webp [T=image/webp,L]

  # ==========================================
  # 6. ROUTAGE ANGULAR
  # ==========================================
  # /404, /403 et /410 (et /en/…) visités directement : ils renvoient aussi leur vrai code
  RewriteRule ^(en/)?404/?$ - [R=404,L]
  RewriteRule ^(en/)?403/?$ - [R=403,L]
  RewriteRule ^(en/)?410/?$ - [R=410,L]

  # Fichier existant (assets, scripts, styles…) → servi tel quel
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Page pré-rendue : /equipe → /equipe/index.html (sans redirection vers /equipe/)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Tout le reste n'existe pas : pas de réécriture, Apache répond 404
  # (ou 403 pour un dossier sans page) avec la page d'erreur pré-rendue ci-dessous
</IfModule>

# ==========================================
# 7. SÉCURITÉ ET PAGES D'ERREUR
# ==========================================
# Désactiver le listing des répertoires (un dossier sans page répond 403)
Options -Indexes

# Empêche Apache de rediriger /equipe vers /equipe/ (301) : les pages pré-rendues sont des dossiers
DirectorySlash Off

# Vrai code HTTP + page d'erreur pré-rendue (Angular affiche la même page au démarrage)
ErrorDocument 404 /404/index.html
ErrorDocument 403 /403/index.html
ErrorDocument 410 /410/index.html

# ==========================================
# 8. PERFORMANCE : COMPRESSION
# ==========================================
# Les fichiers texte sont compressés avant l'envoi (≈ 4× plus légers sur le réseau).
# Les images et polices woff2 sont déjà compressées : inutile de les recompresser.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==========================================
# 9. PERFORMANCE : CACHE NAVIGATEUR
# ==========================================
# Les règles s'appliquent dans l'ordre : la dernière qui correspond l'emporte.
<IfModule mod_headers.c>
  # Images, polices, fichiers divers sans code dans le nom : 7 jours
  # (un fichier remplacé sous le même nom est vu par tous au plus tard une semaine après)
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|ico|svg|woff2?|ttf|otf|mp4|webm|m4a|mp3|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Fichiers du build avec un code dans le nom (main-XXXXXXXX.js, styles-…css, chunk-…js, polices de media/) :
  # leur nom change dès que leur contenu change → gardés 1 an, sans jamais redemander
  <FilesMatch "-[A-Z0-9]{8}\.(js|css|woff2?|ttf|otf|svg|png|jpe?g|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pages HTML (index.html, pages pré-rendues, pages d'erreur), robots.txt, sitemap.xml :
  # même nom à chaque déploiement → le navigateur redemande toujours s'il y a du nouveau
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images : la réponse dépend du navigateur (WebP ou non) → les caches intermédiaires doivent le savoir
  <FilesMatch "\.(png|jpe?g|webp)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ==========================================
# 10. SÉCURITÉ : EN-TÊTES
# ==========================================
# Sans risque de blocage : ils limitent ce qu'un site malveillant peut faire avec le tien
# ("always" : envoyés aussi avec les pages d'erreur)
<IfModule mod_headers.c>
  # Personne d'autre ne peut afficher le site dans une iframe (anti-clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # Le navigateur ne devine jamais le type d'un fichier (un .txt n'est jamais exécuté comme du JS)
  Header always set X-Content-Type-Options "nosniff"
  # Un site externe ne voit que "https://domaine", pas l'adresse complète de la page d'où vient le visiteur
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Le site n'utilise ni caméra, ni micro, ni géolocalisation : personne ne pourra les demander
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HTTPS obligatoire pendant 7 jours (durée courte : si le certificat tombe, blocage d'une semaine au plus)
  Header always set Strict-Transport-Security "max-age=604800"
</IfModule>
